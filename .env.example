# Copy to .env and fill in values, then restart:
#   cp .env.example .env

# Required for PDF export (PDFBolt) — get from https://pdfbolt.com or Vercel env
PDFBOLT_API_KEY=

# PDFBolt webhook signing secret (for verifying async webhook callbacks)
# PDFBOLT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Supabase (Auth + DB + service APIs)
# -----------------------------------------------------------------------------
# Project URL (Settings → API)
# SUPABASE_URL=https://wiudrzdkbpyziaodqoog.supabase.co
# VITE_SUPABASE_URL=https://wiudrzdkbpyziaodqoog.supabase.co

# Anon key (client) — Settings → API → anon public
# VITE_SUPABASE_ANON_KEY=

# Required for create-user, resend-invite, register, download tracking, anonymise
# Supabase → Settings → API → service_role (secret) — NEVER expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=

# Recommended: JWT secret for verifying Bearer tokens on protected APIs
# Supabase → Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=

# Optional salt for hashed/truncated IP storage (download_events)
# IP_HASH_SALT=

# Extra download redirect hosts (comma-separated), in addition to rhythmstix.co.uk
# DOWNLOAD_ALLOWLIST_HOSTS=

# -----------------------------------------------------------------------------
# Resend (optional branded transactional email from serverless routes)
# Prefer also configuring Resend as Supabase custom SMTP for Auth emails.
# See docs/EMAIL_TEMPLATES.md and docs/DEPLOY_USER_MGMT_DOWNLOADS.md
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=CCDesigner <noreply@ccdesigner.co.uk>

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
# Production app origin (password reset / invite redirect targets)
# VITE_APP_URL=https://www.ccdesigner.co.uk

# When frontend is not on the same host as Vercel functions, point API calls here
# VITE_API_BASE_URL=https://your-app.vercel.app
# VITE_VERCEL_URL=https://your-app.vercel.app

# API server port (Vite proxies /api here for local Express PDF server)
PORT=8080
NODE_ENV=development
PDF_LOCAL_DEV=1

# Auth is on by default; set false only for local work without Supabase
# VITE_USE_SUPABASE_AUTH=true
